flowchart TD
    USER["👤 User\ntypes www.foobar.com"]
    DNS["🌐 DNS\nwww → A record → 8.8.8.8"]

    USER -->|"DNS lookup"| DNS
    DNS -->|"HTTPS request to 8.8.8.8"| FW1

    FW1["🔥 Firewall 1\nFilters incoming internet traffic"]
    FW1 -->|"allowed traffic only"| LB

    LB["⚖️ Load Balancer — HAProxy\nSSL certificate installed here\nDecrypts HTTPS → HTTP internally\nRound Robin / Active-Active"]
    MON_LB["📊 Monitoring client\nCollects metrics → Sumo Logic"]
    LB --- MON_LB

    LB -->|"HTTP request"| FW2
    LB -->|"HTTP request"| FW3

    FW2["🔥 Firewall 2\nProtects Server 1"]
    FW3["🔥 Firewall 3\nProtects Server 2"]

    FW2 --> S1
    FW3 --> S2

    subgraph S1["🖥️ Server 1"]
        NGINX1["Nginx — Web server"]
        APP1["Application server"]
        CODE1["Codebase"]
        DB1["MySQL — Primary\nWRITE only"]
        MON1["📊 Monitoring client\nCollects metrics → Sumo Logic"]

        NGINX1 -->|"dynamic requests"| APP1
        APP1 --> CODE1
        APP1 -->|"WRITE"| DB1
    end

    subgraph S2["🖥️ Server 2"]
        NGINX2["Nginx — Web server"]
        APP2["Application server"]
        CODE2["Codebase"]
        DB2["MySQL — Replica\nREAD only"]
        MON2["📊 Monitoring client\nCollects metrics → Sumo Logic"]

        NGINX2 -->|"dynamic requests"| APP2
        APP2 --> CODE2
        APP2 -->|"READ"| DB2
    end

    DB1 -->|"replication"| DB2

    ISSUES["⚠️ Issues\nSSL terminated at LB = unencrypted internal traffic\nSingle Primary DB = SPOF for writes\nAll components on same server = resource conflicts"]
    S1 -.-> ISSUES
    S2 -.-> ISSUES
	